types EstateActionsTypes
{
	type estate_action_button = card_list_button {
		# 2026-10 修 1.4：原 base "card_list_action_button" 不是 widget 类型（只是贴图名）
		# → 报 "is not a valid widget/type/property"，导致本类型失效并连带原版阶层行动面板。
		# 类型体照搬 1.4 原版 estate_action_button（[UIAction.*] 已换成 [GenericAction.*]）。
		blockoverride "card_list_button_paper_alpha" {
			alpha = 0.2
		}

		visible = "[PdxGuiWidget.IsUberButtonVisible]"
		enabled = "[PdxGuiWidget.IsUberButtonEnabled]"

		scripted_action_tooltip = {
			click_type = left
			click_mode = confirm
			action_name = "[GenericAction.GetLeftClickAndHoldKey]"
			actor = "[Player]"
			parameter = {
				parameter_name = "target"
				parameter_value = "[EstateActionsLateralView.GetEstate]"
			}
		}

		# 2026-10 修 1.4：改用原版标准模板。原写法（自建 estate_action_tooltip 模板 +
		# [UIAction.GetTitle] + 硬编码材质图标）会绕过引擎自动生成的"不可用原因/效果列表"块。
		tooltipwidget = {
			using = generic_action_tooltip
		}

		vbox = {
			set_parent_size_to_minimum = yes
			minimumsize = { 520 -1 }
			maximumsize = { 520 -1 }

			margin = { 8 6 }
			spacing = 4

			hbox = {
				layoutpolicy_horizontal = expanding
				spacing = 10

				icon = {
					size = { 32 32 }
					block "action_icon" {
						texture = "[GenericAction.GetIcon]"
					}
					texture_density = 2
					glow = {
						name = "drop_shadow"
						glow_radius = 3
						color = { 0.0 0.0 0.0 1.0 }
						alpha = 0.4
					}
				}

				text_single = {
					layoutpolicy_horizontal = expanding
					align = nobaseline|left
					default_format = "#yellow_titles"
					using = Font_Size_Medium
					text = "[GenericAction.GetNameWithNoTooltip]"
				}
			}

			TooltipConditionListContent = {
				datacontext = "[StringToConditionListOnlyPassedAndNeutral(UIAction.GetEffects)]"
				visible = "[ConditionList.HasItems]"
				layoutpolicy_horizontal = expanding
			}
		}
	}
}

lateralview = {
	name = "estate_actions_lateralview"

	blockoverride "panel_header" {
		window_header_alt = {
			blockoverride "header_text" {
				text = "ESTATE_ACTIONS_LATERALVIEW_T"
				default_format = "#yellow_titles"
			}
			blockoverride "window_header_alt_color_texture" {
				using = color_government_texture
			}
		}
	}

	blockoverride "panel_content" {
		vbox = {
			using = layoutpolicy_expanding
			using = bg_main_inner_alt
			using = window_main_tabs_margin_alt
			spacing = 8

			# Estate card header — reuses the full estate card top part from government_lateralview
			estate_card_top_part = {
				datacontext = "[EstateActionsLateralView.GetEstate]"
			}

			# Action buttons — scrollable vertical list
			scrollarea = {
				using = layoutpolicy_expanding
				scrollbarpolicy_horizontal = always_off

				scrollbar_vertical = {
					using = Scrollbar_Vertical
				}

				scrollwidget = {
					vbox = {
						layoutpolicy_horizontal = expanding
						spacing = 4

						estate_action_button = {
							datacontext = "[GetGenericAction('bribe_estate')]"
							blockoverride "action_icon" {
								texture = "gfx/interface/icons/resources/bribe.dds"
							}
						}

						estate_action_button = {
							datacontext = "[GetGenericAction('press_estate_private_regiments_action')]"
						}

						estate_action_button = {
							datacontext = "[GetGenericAction('ask_for_extra_levies')]"
							blockoverride "action_icon" {
								texture = "[GetConceptTexture('levies')]"
							}
						}

						estate_action_button = {
							datacontext = "[GetGenericAction('extraordinary_taxes')]"
							blockoverride "action_icon" {
								texture = "gfx/interface/icons/resources/gold.dds"
							}
						}

						estate_action_button = {
							datacontext = "[GetGenericAction('ask_clergy_for_legitimacy')]"
							blockoverride "action_icon" {
								texture = "gfx/interface/icons/resources/legitimacy.dds"
							}
						}

						estate_action_button = {
							datacontext = "[GetGenericAction('ask_nobility_for_diplomats')]"
							blockoverride "action_icon" {
								texture = "gfx/interface/icons/flat_icons/diplomatic_actions.dds"
							}
						}

						estate_action_button = {
							datacontext = "[GetGenericAction('ask_burghers_for_loan')]"
							blockoverride "action_icon" {
								texture = "gfx/interface/icons/flat_icons/debt.dds"
							}
						}

						estate_action_button = {
							datacontext = "[GetGenericAction('ask_commoners_for_stability')]"
							blockoverride "action_icon" {
								texture = "gfx/interface/icons/resources/stability.dds"
							}
						}

						estate_action_button = {
							datacontext = "[GetGenericAction('ask_tribes_for_manpower')]"
							blockoverride "action_icon" {
								texture = "gfx/interface/icons/resources/manpower.dds"
							}
						}

						estate_action_button = {
							datacontext = "[GetGenericAction('call_emergency_parliament')]"
							blockoverride "action_icon" {
								texture = "gfx/interface/icons/flat_icons/parliament.dds"
							}
						}
						
						estate_action_button = {
							datacontext = "[GetGenericAction('perform_reduction')]"
							blockoverride "action_icon" {
								texture = "gfx/interface/icons/modifier_types/estate_building_destruction_satisfaction_impact.dds"
							}
						}

						# 刀锋与王座：请求士兵平叛（士兵阶层专属互动）
						estate_action_button = {
							datacontext = "[GetGenericAction('ask_soldiers_for_suppression')]"
							blockoverride "action_icon" {
								texture = "gfx/interface/icons/military_objectives/tactical_suppress_rebels.dds"
							}
						}
					}
				}
			}
		}
	}
}
