disaster_panel = {

	##################################### TAB NAME #####################################

	blockoverride "disaster_secondary_tab" {
		margin_top = 10
		spacing = 5
		disaster_card_expandable = {
			blockoverride "header_button_onclick" {
				onclick = "[LateralView.Vars.Toggle( 'requirements_toggled' )]"
			}
			blockoverride "header_text" {
				text = "END_REQUIREMENTS"
			}
			blockoverride "header_icon" {
				texture = "gfx/interface/icons/disasters/end_requirements_green.dds"
			}
			blockoverride "bottom_content" {
				TooltipRequirementsList = {
					textcontext = "[DisasterView.GetDisaster.GetType.GetEndConditions]"
				}
			}
			blockoverride "bottom_content_onclick" {
				visible = "[LateralView.Vars.Exists( 'requirements_toggled' )]"
			}
			blockoverride "icon_replace_visible_yes" {
				visible = "[LateralView.Vars.Exists( 'requirements_toggled' )]"
			}
			blockoverride "icon_replace_visible_not" {
				visible = "[Not(LateralView.Vars.Exists( 'requirements_toggled' ))]"
			}
		}
	}

	##################################### MAIN CONTENT #####################################

	blockoverride "disaster_main_content_subheader" {}
	blockoverride "disaster_description" {}
	blockoverride "disaster_monthly_outcomes" {}

	blockoverride "main_content" {
		vbox = {
			layoutpolicy_horizontal = expanding
			spacing = 12

			hbox = {
				layoutpolicy_horizontal = expanding
				spacing = 10

				text_single = {
					layoutpolicy_horizontal = expanding
					align = left|nobaseline
					fontsize = 16
					text = "blades_and_thrones_junta_stability_label"
				}

				text_single = {
					size = { 90 30 }
					align = right|nobaseline
					fontsize = 18
					text = "[FixedPointToFloat(DisasterView.GetDisaster.GetOwner.MakeScope.GetVariable('blades_and_thrones_junta_stability').GetValue)|0]"
				}
			}

			progressbar = {
				visible = yes
				layoutpolicy_horizontal = expanding
				size = { -1 14 }
				using = progress_bar_red_alt
				min = 0
				max = 100
				value = "[FixedPointToFloat(DisasterView.GetDisaster.GetOwner.MakeScope.GetVariable('blades_and_thrones_junta_stability').GetValue)]"
				direction = horizontal
			}

			hbox = {
				layoutpolicy_horizontal = expanding
				spacing = 10

				text_single = {
					layoutpolicy_horizontal = expanding
					align = left|nobaseline
					fontsize = 13
					text = "blades_and_thrones_junta_change_stability_label"
				}

				text_single = {
					size = { 90 30 }
					align = right|nobaseline
					fontsize = 13
					text = "[FixedPointToFloat(DisasterView.GetDisaster.GetOwner.MakeScope.GetVariable('blades_and_thrones_junta_change_stability_part').GetValue)|+0]"
				}
			}

			hbox = {
				layoutpolicy_horizontal = expanding
				spacing = 10

				text_single = {
					layoutpolicy_horizontal = expanding
					align = left|nobaseline
					fontsize = 13
					text = "blades_and_thrones_junta_change_legitimacy_label"
				}

				text_single = {
					size = { 90 30 }
					align = right|nobaseline
					fontsize = 13
					text = "[FixedPointToFloat(DisasterView.GetDisaster.GetOwner.MakeScope.GetVariable('blades_and_thrones_junta_change_legitimacy_part').GetValue)|+0]"
				}
			}

			hbox = {
				layoutpolicy_horizontal = expanding
				spacing = 10

				text_single = {
					layoutpolicy_horizontal = expanding
					align = left|nobaseline
					fontsize = 13
					text = "blades_and_thrones_junta_change_loyalty_label"
				}

				text_single = {
					size = { 90 30 }
					align = right|nobaseline
					fontsize = 13
					text = "[FixedPointToFloat(DisasterView.GetDisaster.GetOwner.MakeScope.GetVariable('blades_and_thrones_junta_change_loyalty_part').GetValue)|+0]"
				}
			}

			hbox = {
				layoutpolicy_horizontal = expanding
				spacing = 10

				text_single = {
					layoutpolicy_horizontal = expanding
					align = left|nobaseline
					fontsize = 13
					text = "blades_and_thrones_junta_change_war_label"
				}

				text_single = {
					size = { 90 30 }
					align = right|nobaseline
					fontsize = 13
					text = "[FixedPointToFloat(DisasterView.GetDisaster.GetOwner.MakeScope.GetVariable('blades_and_thrones_junta_change_war_part').GetValue)|+0]"
				}
			}

			hbox = {
				layoutpolicy_horizontal = expanding
				spacing = 10

				text_single = {
					layoutpolicy_horizontal = expanding
					align = left|nobaseline
					fontsize = 14
					text = "blades_and_thrones_junta_stability_change_label"
				}

				text_single = {
					size = { 90 30 }
					align = right|nobaseline
					fontsize = 14
					text = "[FixedPointToFloat(DisasterView.GetDisaster.GetOwner.MakeScope.GetVariable('blades_and_thrones_junta_stability_growth').GetValue)|+0]"
				}
			}

			vbox = {
				layoutpolicy_horizontal = expanding
				spacing = 4

				text_single = {
					layoutpolicy_horizontal = expanding
					align = left|nobaseline
					fontsize = 13
					text = "blades_and_thrones_junta_threshold_crisis"
				}

				text_single = {
					layoutpolicy_horizontal = expanding
					align = left|nobaseline
					fontsize = 13
					text = "blades_and_thrones_junta_threshold_restore"
				}

				text_single = {
					layoutpolicy_horizontal = expanding
					align = left|nobaseline
					fontsize = 13
					text = "blades_and_thrones_junta_threshold_mid"
				}

				text_single = {
					layoutpolicy_horizontal = expanding
					align = left|nobaseline
					fontsize = 13
					text = "blades_and_thrones_junta_threshold_consolidate"
				}
			}
		}
	}
}
